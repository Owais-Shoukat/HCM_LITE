# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret for signing JWT tokens
JWT_SECRET="saylani-hcm-lite-jwt-secret-key-change-in-production"

# DATABASE_URL: Optional PostgreSQL connection string (defaults to local SQLite + atomic JSON store)
DATABASE_URL="postgresql://postgres:password@localhost:5432/saylani_hcm"
